# Hash-pinned policy files must have identical bytes on every platform.
solution/policies/** text eol=lf
# Shell scripts and nginx templates run in Linux containers built from this working tree (ACR remote builds).
*.sh text eol=lf
solution/ui/nginx/** text eol=lf
# The extensionless harness launcher runs under sh and needs LF even on Windows checkouts.
harness text eol=lf
# cmd parses batch files reliably only with CRLF endings.
*.cmd text eol=crlf
