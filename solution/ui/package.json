{
  "name": "biotrackr-chat-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Text-only browser client for the Biotrackr solution chat API (AG-UI over SSE, MSAL sign-in).",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "5.29.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
