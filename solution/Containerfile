FROM docker.io/library/python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.9.28 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    HOME=/home/app

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --home-dir /home/app --create-home --shell /usr/sbin/nologin app

WORKDIR /app

# ASI04: --frozen installs exactly what uv.lock pins, hashes included.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
RUN uv sync --frozen --no-dev

# ASI01, ASI02, ASI04: pinned prompt, governance policy, injection patterns, and MCP descriptor lock.
COPY policies ./policies

ENV PATH="/app/.venv/bin:${PATH}" \
    POLICY_DIR=/app/policies

# Local Compose only (ADR-0022): Azure CLI so DefaultAzureCredential can use the developer's az login,
# cached in the azcli-cache volume at /home/app/.azure (owned by UID 10001). Never built for Azure.
FROM base AS dev
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg lsb-release \
    && curl -sL https://aka.ms/InstallAzureCLIDeb | bash \
    && apt-get purge -y gnupg lsb-release && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 10001 -g 10001 -m 0700 /home/app/.azure
USER 10001
CMD ["python", "-m", "chat_api"]

# Default target, used by azd remote builds in ACR: no Azure CLI, no credentials, non-root.
FROM base AS runtime
USER 10001
# One image for every service; each Compose service or container app selects its module with
# command: ["python", "-m", "<module>"].
CMD ["python", "-m", "chat_api"]
