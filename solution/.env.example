# Copy to .env and fill in. .env is gitignored.
# The provisioning script prints every value below (scripts/README.md); `azd env get-values` shows the Azure ones.

# Identity: entra (default) or local (stage-only simulator, offline profile).
IDENTITY_MODE=entra
TENANT_ID=<tenant-guid>
BLUEPRINT_APP_ID=<guid>
CHAT_AGENT_APP_ID=<guid>
HEALTH_MCP_APP_ID=<guid>
REPORT_API_APP_ID=<guid>
CLI_APP_ID=<guid>
# Browser client (biotrackr-demo-spa), written by the provisioning script.
SPA_APP_ID=<guid>
ALICE_OID=<guid>
BOB_OID=<guid>
ALICE_UPN=alice@<tenant>.onmicrosoft.com
BOB_UPN=bob@<tenant>.onmicrosoft.com

# ASI03: solution Foundry project (key auth disabled); Entra only, from `azd env get-value FOUNDRY_PROJECT_ENDPOINT`.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4.1

# Well-known Cosmos DB emulator key (public, emulator only). Real Cosmos DB accounts use Entra; the
# services never send a key to an https endpoint.
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# Optional OTLP collector, for example http://host.containers.internal:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
